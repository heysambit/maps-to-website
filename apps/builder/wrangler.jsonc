{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maps-to-website-builder",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "vars": { "APP_ENV": "development", "PLACES_LOOKUP_ENABLED": "false", "UPLOADS_ENABLED": "false", "PLACES_ASSERTION_SECRET": "local-fixture-signing-key-do-not-deploy", "LOCAL_OPERATOR_TOKEN": "local-only-demo-token-not-for-deploy", "ACCESS_TEAM_DOMAIN": "", "OPERATOR_ACCESS_AUD": "", "REVIEWER_ACCESS_AUD": "", "OPERATOR_EMAILS": "", "OPERATOR_HOST": "", "REVIEWER_HOST": "", "ALLOWED_RELEASE_HOSTS": "fixture.example", "RELEASE_SERVICE_TOKEN": "local-fixture-release-service-token-not-for-deploy", "LIVE_DEPLOY_ENABLED": "false" },
  "d1_databases": [
    { "binding": "DB", "database_name": "maps-to-website-local", "database_id": "local-development-only", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "maps-to-website-local-media" },
    { "binding": "RELEASES", "bucket_name": "maps-to-website-local-releases" }
  ],
  "env": {
    "production": {
      "vars": { "APP_ENV": "production", "PLACES_LOOKUP_ENABLED": "false", "UPLOADS_ENABLED": "false", "ACCESS_TEAM_DOMAIN": "configure-through-authorized-cloudflare-setup", "OPERATOR_ACCESS_AUD": "configure-through-authorized-cloudflare-setup", "REVIEWER_ACCESS_AUD": "configure-through-authorized-cloudflare-setup", "OPERATOR_HOST": "configure-through-authorized-cloudflare-setup", "REVIEWER_HOST": "configure-through-authorized-cloudflare-setup", "OPERATOR_EMAILS": "configure-through-authorized-cloudflare-setup", "ALLOWED_RELEASE_HOSTS": "", "LIVE_DEPLOY_ENABLED": "false" },
      "d1_databases": [
        { "binding": "DB", "database_name": "maps-to-website-production", "database_id": "configure-outside-repo", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "configure-outside-repo" },
        { "binding": "RELEASES", "bucket_name": "configure-outside-repo" }
      ]
    }
  }
}
