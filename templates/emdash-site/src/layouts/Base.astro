---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";

interface Props { title: string; description?: string | null; }
const { title, description = "" } = Astro.props;
const page = createPublicPageContext({ Astro, kind: "custom", pageType: "website", title, pageTitle: title, description, siteName: title });
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<EmDashHead page={page} />
	</head>
	<body>
		<EmDashBodyStart page={page} />
		<slot />
		<EmDashBodyEnd page={page} />
	</body>
</html>
